# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.
# "(Phase N)" marks when the app starts reading a variable.

# --- Core (Phase 1) ---------------------------------------------------------
# Postgres connection string. Local: postgres://postgres@localhost:5432/fairankauf
# Production: Neon → Project (region Frankfurt, aws-eu-central-1) → Connect →
# "Pooled connection" string, with ?sslmode=require.
DATABASE_URL=postgres://postgres@localhost:5432/fairankauf

# Public base URL of the site, without trailing slash. Used for the sitemap and
# Open Graph. Production: https://fairankauf.de
APP_URL=http://localhost:3000

# --- Notifications (Phase 3) — step-by-step setup: docs/whatsapp-setup.md ---
# Which provider sends the new-lead message: console | callmebot | whatsapp_cloud
NOTIFICATION_PROVIDER=console
# Your phone number that receives notifications, E.164 format.
NOTIFY_PHONE=+4915156041400
# CallMeBot API key, sent to you by CallMeBot during the one-time activation.
CALLMEBOT_API_KEY=
# WhatsApp Cloud API (Meta). From Meta Business → WhatsApp → API Setup.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# Name and language of the approved message template.
WHATSAPP_CLOUD_TEMPLATE=new_car_lead
WHATSAPP_CLOUD_TEMPLATE_LANG=de
# Protects the daily job that re-sends failed notifications (Vercel Cron sends it
# automatically). Generate with: openssl rand -base64 32
CRON_SECRET=

# --- Spam protection ----------------------------------------------
# Cloudflare Turnstile keys (Cloudflare dashboard → Turnstile → Add site).
# OPTIONAL: leave both empty to skip Turnstile (honeypot + rate limit still apply).
# The site key is public; the secret key stays on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# OPTIONAL: salt for hashing IP addresses before they are stored for rate limiting.
# Generate with: openssl rand -base64 32
IP_HASH_SALT=
