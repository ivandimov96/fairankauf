# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# Public base URL of the site, without trailing slash. Used for the sitemap and
# Open Graph. Production: https://fairankauf.de
APP_URL=http://localhost:3000

# --- Notifications ------------------------------------------------------------
# Every lead goes to each channel that is fully configured; a channel with none of
# its variables set is off. With no channel at all, leads only go to the server log.
# Setup steps for both: docs/DEPLOY.md, step 1.

# Email via your own mailbox (SMTP). Yahoo: smtp.mail.yahoo.com, Gmail: smtp.gmail.com,
# port 465, your address as user, an "app password" (not your login password) as pass.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender address; defaults to SMTP_USER (mail providers insist it matches the account).
SMTP_FROM=
# Where the lead emails go. Several addresses: separate with commas.
LEAD_EMAIL_TO=

# WhatsApp via the Meta WhatsApp Business Platform (Cloud API).
# Permanent token of a system user with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=
# Numeric "Phone number ID" of the sender number (WhatsApp → API Setup).
WHATSAPP_PHONE_NUMBER_ID=
# Numbers that receive the lead, international format, separated by commas.
LEAD_WHATSAPP_TO=
# Approved message template (see docs/DEPLOY.md for its text) and its language.
WHATSAPP_TEMPLATE_NAME=neue_anfrage
WHATSAPP_TEMPLATE_LANGUAGE=de

# --- Spam protection ----------------------------------------------
# Cloudflare Turnstile keys (Cloudflare dashboard → Turnstile → Add site).
# OPTIONAL: leave both empty to skip Turnstile (honeypot + rate limit still apply).
# The site key is public; the secret key stays on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
