# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.
# "(Phase N)" marks when the app starts reading a variable.

# --- Core (Phase 1) ---------------------------------------------------------
# Postgres connection string. Local: postgres://postgres@localhost:5432/fairankauf
# Production: Neon → Project (region Frankfurt, aws-eu-central-1) → Connect →
# "Pooled connection" string, with ?sslmode=require.
DATABASE_URL=postgres://postgres@localhost:5432/fairankauf

# Public base URL of the site, without trailing slash. Used for links in
# WhatsApp messages, sitemap and Open Graph. Production: https://fairankauf.de
APP_URL=http://localhost:3000

# --- Notifications (Phase 3) — step-by-step setup: docs/whatsapp-setup.md ---
# Which provider sends the new-lead message: console | callmebot | whatsapp_cloud
NOTIFICATION_PROVIDER=console
# Your phone number that receives notifications, E.164 format.
NOTIFY_PHONE=+4915156041400
# CallMeBot API key, sent to you by CallMeBot during the one-time activation.
CALLMEBOT_API_KEY=
# WhatsApp Cloud API (Meta). From Meta Business → WhatsApp → API Setup.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# Name and language of the approved message template.
WHATSAPP_CLOUD_TEMPLATE=new_car_lead
WHATSAPP_CLOUD_TEMPLATE_LANG=de

# --- Photos (Phase 4) -------------------------------------------------------
# Vercel Blob read/write token. Created automatically when you connect a Blob
# store to the Vercel project; copy it here for local development.
BLOB_READ_WRITE_TOKEN=

# --- Admin auth (Phase 5) ---------------------------------------------------
# scrypt hash of your admin password. Generate with: pnpm hash-password
ADMIN_PASSWORD_HASH=
# Random secret (min. 32 chars) that signs the session cookie.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Spam protection (Phase 7) ----------------------------------------------
# Cloudflare Turnstile keys (Cloudflare dashboard → Turnstile → Add site).
# The site key is public; the secret key stays on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Salt for hashing IP addresses before they are stored for rate limiting.
# Generate with: openssl rand -base64 32
IP_HASH_SALT=
