# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# Public base URL of the site, without trailing slash. Used for the sitemap and
# Open Graph. Production: https://fairankauf.de
APP_URL=http://localhost:3000

# --- Notifications — step-by-step setup: docs/whatsapp-setup.md ---
# Which provider sends the new-lead message: console | callmebot | telegram | whatsapp_cloud
NOTIFICATION_PROVIDER=console
# Your phone number that receives notifications, E.164 format.
NOTIFY_PHONE=+4915156041400
# CallMeBot API key, sent to you by CallMeBot during the one-time activation.
CALLMEBOT_API_KEY=
# Telegram: token from @BotFather and your chat id (docs/whatsapp-setup.md, Option 2).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp Cloud API (Meta). From Meta Business → WhatsApp → API Setup.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# Name and language of the approved message template.
WHATSAPP_CLOUD_TEMPLATE=new_car_lead
WHATSAPP_CLOUD_TEMPLATE_LANG=de

# --- Spam protection ----------------------------------------------
# Cloudflare Turnstile keys (Cloudflare dashboard → Turnstile → Add site).
# OPTIONAL: leave both empty to skip Turnstile (honeypot + rate limit still apply).
# The site key is public; the secret key stays on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
