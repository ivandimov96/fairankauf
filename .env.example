# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# Public base URL of the site, without trailing slash. Used for the sitemap and
# Open Graph. Production: https://fairankauf.de
APP_URL=http://localhost:3000

# --- Notifications — step-by-step setup: docs/notifications-setup.md ---------
# Every channel whose key is set receives each lead. With none set, leads are
# printed in the terminal (local development).

# Email from your own mailbox over SMTP. Gmail: a Google App Password
# (docs/notifications-setup.md, section 1). The lead goes to SMTP_USER itself.
SMTP_USER=vlado.dimov2@gmail.com
SMTP_PASS=
# OPTIONAL: another mailbox (defaults: smtp.gmail.com, 465), another recipient,
# another sender name (default: FairAnkauf <SMTP_USER>).
SMTP_HOST=
SMTP_PORT=
NOTIFY_EMAIL=
EMAIL_FROM=

# WhatsApp via the official Meta Cloud API (Meta for Developers → WhatsApp → API Setup).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# Your own WhatsApp number that receives the leads, E.164 format.
NOTIFY_PHONE=+38971943038
# Name and language of the approved message template.
WHATSAPP_CLOUD_TEMPLATE=new_car_lead
WHATSAPP_CLOUD_TEMPLATE_LANG=de

# OPTIONAL: Telegram bot (docs/notifications-setup.md, section 3).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Spam protection ----------------------------------------------
# Cloudflare Turnstile keys (Cloudflare dashboard → Turnstile → Add site).
# OPTIONAL: leave both empty to skip Turnstile (honeypot + rate limit still apply).
# The site key is public; the secret key stays on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
